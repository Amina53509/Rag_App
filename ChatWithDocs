import os
import requests
import gradio as gr
from google.colab import userdata
from groq import Groq
from langchain_community.document_loaders import PyPDFLoader
from langchain_text_splitters import RecursiveCharacterTextSplitter 
from langchain_community.embeddings import HuggingFaceEmbeddings
from langchain_community.vectorstores import FAISS

# 1. SETUP: SECURE KEY ACCESS
# Ensure you have 'GROQ_API_KEY' in your Colab Secrets (Key icon)
try:
    api_key = userdata.get('GROQ_API_KEY')
    os.environ["GROQ_API_KEY"] = api_key
    client = Groq(api_key=api_key, timeout=30.0, max_retries=3)
    print("✅ Groq API Key connected successfully.")
except Exception as e:
    print(f"❌ API Key Error: Please add 'GROQ_API_KEY' to Colab Secrets. Error: {e}")

# 2. LIST YOUR DOCUMENTS
drive_links = [
    "https://drive.google.com/file/d/1OvAsmKYWC6WzuQbwBnl3ItQE3XxYGThw/view?usp=drive_link"
]

def initialize_vector_db(links):
    all_docs = []
    print("🔄 Starting Document Processing...")
    session = requests.Session()
    
    for url in links:
        try:
            file_id = url.split('/')[-2]
            download_url = f'https://drive.google.com/uc?export=download&id={file_id}'
            
            # Handle Google Drive large file confirmation
            response = session.get(download_url, stream=True)
            confirm_token = None
            for key, value in response.cookies.items():
                if key.startswith('download_warning'):
                    confirm_token = value
            
            if confirm_token:
                download_url += f'&confirm={confirm_token}'
                response = session.get(download_url, stream=True)

            temp_filename = f"temp_{file_id}.pdf"
            with open(temp_filename, "wb") as f:
                for chunk in response.iter_content(chunk_size=32768):
                    if chunk: f.write(chunk)
            
            # Basic validation to ensure it's a PDF and not an HTML error page
            with open(temp_filename, 'rb') as f:
                if f.read(4) != b'%PDF':
                    print(f"❌ Error: {file_id} is not a valid PDF. Check if link is public.")
                    continue

            loader = PyPDFLoader(temp_filename)
            all_docs.extend(loader.load())
            os.remove(temp_filename)
            print(f"✅ Successfully loaded: {file_id}")
        except Exception as e:
            print(f"❌ Error loading {url}: {e}")

    if not all_docs:
        print("⚠️ No documents were loaded. Stopping initialization.")
        return None

    # Text Splitting (Chunking)
    text_splitter = RecursiveCharacterTextSplitter(chunk_size=1000, chunk_overlap=150)
    final_chunks = text_splitter.split_documents(all_docs)

    # Creating Embeddings and Vector DB
    embeddings = HuggingFaceEmbeddings(model_name="all-MiniLM-L6-v2")
    vectorstore = FAISS.from_documents(final_chunks, embeddings)
    print("✅ Vector Database Ready!")
    return vectorstore

# Initialize DB
vector_db = initialize_vector_db(drive_links)

# 3. THE CHAT FUNCTION
def chat_with_docs(user_query, history):
    if vector_db is None:
        return "Error: Knowledge base is empty. Check your Colab logs."

    try:
        # Similarity Search
        docs = vector_db.similarity_search(user_query, k=3)
        context = "\n\n".join([doc.page_content for doc in docs])

        # Constructing the RAG Prompt
        prompt = f"Context: {context}\n\nQuestion: {user_query}\n\nAnswer only using the provided context."

        # Model Inference
        chat_completion = client.chat.completions.create(
            messages=[{"role": "user", "content": prompt}],
            model="llama-3.3-70b-versatile",
        )
        return chat_completion.choices[0].message.content
    except Exception as e:
        return f"System Error: {str(e)}"

# 4. LAUNCH GRADIO UI
demo = gr.ChatInterface(
    fn=chat_with_docs, 
    title="PDF RAG Assistant",
    description="Ask questions about your uploaded Google Drive documents."
)

if __name__ == "__main__":
    demo.launch(debug=True, share=True)
